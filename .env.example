INTERVALS_ATHLETE_ID=i12345
INTERVALS_API_KEY=your_api_key_here

# Only for `npm run start:http` (local test of the remote/OAuth setup). On Lambda these
# come from SSM Parameter Store instead; see `npm run users`.
# Signs in as MCP_USERNAME (default "me") with the athlete above:
# MCP_USERNAME=me
# MCP_PASSWORD=at-least-16-characters
# MCP_SIGNING_SECRET=at-least-32-random-characters
# Or several users, as the JSON array Lambda uses (overrides MCP_USERNAME/MCP_PASSWORD):
# MCP_USERS=[{"name":"me","password":"...","athleteId":"i12345","apiKey":"..."}]
